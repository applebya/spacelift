{
  "name": "spacelift",
  "description": "Marketing website for Spacelift, transform your space.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Andrew Appleby",
    "email": "andrewappleby22@gmail.com",
    "url": "https://github.com/applebya"
  },
  "scripts": {
    "dev": "vite",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist",
    "postbuild": "echo spacelift.online > dist/CNAME",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "vitest",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,js,json}\"",
    "generate:brand-assets": "node tools/generate-social-image.mjs",
    "test:run": "vitest run"
  },
  "dependencies": {
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "^3.1.5",
      "minimatch@9": "^9.0.9",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.7",
      "glob@10": "^10.5.0",
      "rollup@4": "^4.63.0",
      "yaml@2": "^2.9.0",
      "@babel/runtime@7": "^7.29.7"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10"
      }
    }
  }
}
